<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>NeoVisual.Tests</RootNamespace>
    <StartupObject>NeoVisual.Tests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MyExtension\MyExtension.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestRunner.cs" Link="TestRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- MyExtension references the VS SDK with ExcludeAssets="runtime" (VS supplies it at load
         time). The pure-logic tests here don't touch VS services, but the assemblies must be
         resolvable so the MyExtension types can be JIT'd. Pull the interop + shell framework in
         for runtime resolution, mirroring the Telescope test project. -->
    <PackageReference Include="Microsoft.VisualStudio.Interop" Version="17.14.40260" ExcludeAssets="build;analyzers" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" Version="17.14.40264" ExcludeAssets="build;analyzers" />
    <!-- ITextView lives in Microsoft.VisualStudio.Text.UI.dll, which is NOT in Shell.Framework.
         The VimModeSource fake passes null! for ITextView, but the type must be resolvable at
         runtime for the MyExtension types to JIT. VimModeTracker also implements
         IWpfTextViewCreationListener, so the sibling Text.UI.Wpf assembly is required too. -->
    <PackageReference Include="Microsoft.VisualStudio.Text.UI" Version="17.14.249" ExcludeAssets="build;analyzers" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="17.14.249" ExcludeAssets="build;analyzers" />
    <!-- m4 (BP-63): MyExtension references Microsoft.VisualStudio.LanguageServices with
         ExcludeAssets="runtime" (VS supplies it at load time), which propagates transitively — so
         Microsoft.CodeAnalysis.Workspaces.dll is NOT copied to this test output. The
         Run_RoslynGatherers_IsWriteLocation test constructs a ReferenceLocation at runtime (via
         the internal ctor), so pull the Workspaces.Common runtime asset in here for resolution in
         the test process. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.14.0" ExcludeAssets="build;analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>